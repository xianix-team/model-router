{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Proxy": {
    "Pipeline": {
      "InjectAgentHint": true,
      "ToolChoice": "required",
      "SystemAppend": ""
    },
    "Providers": {
      "OpenAI": {
        "ApiKey": "sk-proj-REPLACE_ME",
        "BaseUrl": "https://api.openai.com",
        "DefaultModel": "gpt-4o",
        "MaxCompletionTokensCap": 16384,
        "SkipCompletionTokenCap": false
      },
      "AzureOpenAI": {
        "Endpoint": "https://YOUR_RESOURCE.openai.azure.com",
        "ApiKey": "REPLACE_ME",
        "DeploymentName": "gpt-4o",
        "ApiVersion": "2024-02-01"
      },
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "DefaultModel": "llama3:8b",
        "ModelPrefixes": "llama,mistral,phi,gemma,qwen"
      },
      "Anthropic": {
        "ApiKey": "sk-ant-REPLACE_ME"
      }
    },
    "ProviderRouting": {
      "Rules": [
        { "ModelPrefix": "claude-", "Provider": "OpenAI" },
        { "ModelPrefix": "llama",   "Provider": "Ollama"  },
        { "ModelPrefix": "*",       "Provider": "OpenAI"  }
      ]
    },
    "Logging": {
      "Enabled": true,
      "FilePath": "proxy-audit.log"
    }
  },
  "Urls": "http://0.0.0.0:8766",
  "AllowedHosts": "*"
}
